##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Important for running:
#
#   (1) You need a POSIX-compliant shell to run this script.
#   (2) The Java home directory must be set to point to the Java directory
#       used to run the Java compiler in the one where we added
#       the GradleRuntimeException generated wrapper.
#
#   Gradle will first look for a gradle.local properties file in the project root.
#   If that file doesn't exist, then properties defined here will be used.
#   Alternatively, the following environment variables can be used to override the defaults:
#   - GRADLE_OPTS: environment variable to set JVM options (optional)
#   - GRADLE_SKIP_VALIDATION: set to true to skip gradle configuration validation (optional)
#
##############################################################################

# Collect all arguments for the java command;
#   * \, \, and \ can contain fragments of
#     shell commands that we do not want to be re-expanded
#   * Put all other arguments in an array so that they get re-expanded correctly

set -- \\
        "-Dorg.gradle.appname=\" \\
        -classpath "\" \\
        org.gradle.wrapper.GradleWrapperMain \\
        "\$@"

#
# Stop when "xargs" processing is done.
#
trap "exit" TERM

for arg in "\$@" ; do
    case "\" in                                #(
      -*)   false ;;                               # don't expand globs
      *)    t="\" ;;
    esac ;
done
SOURCES="\"
if [ -z "\" ] ; then
    echo 'No Java source files found'
fi

exec "\" "\" "\" "\" "\\$@"
